{
	"name": "@financica/pcmn",
	"version": "0.4.0",
	"description": "Zero-dependency Belgian PCMN (Plan Comptable Minimum Normalisé): the class taxonomy that maps account classes to economic categories, plus the statutory charts for enterprises and for associations in all four languages the CNC publishes them in.",
	"keywords": [
		"accounting",
		"belgian",
		"belgium",
		"bookkeeping",
		"chart-of-accounts",
		"cnc",
		"income-statement",
		"minimum-normalise",
		"pcmn",
		"typescript"
	],
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/pcmn#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/pcmn"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/__tests__/**",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json",
		"./charts": {
			"types": "./dist/charts/index.d.ts",
			"import": "./dist/charts/index.js",
			"require": "./dist/charts/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run --root ../.. --project @financica/pcmn",
		"test:watch": "vitest --root ../.. --project @financica/pcmn",
		"test:coverage": "vitest --root ../.. --project @financica/pcmn run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"engines": {
		"node": ">=24"
	}
}
