{
	"name": "@financica/ubl",
	"version": "0.17.0",
	"description": "UBL (Universal Business Language) invoice toolkit for TypeScript: parse, build, and serialize Peppol BIS Billing 3.0 documents.",
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/ubl#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/ubl"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/__tests__/**",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./build": {
			"types": "./dist/build/index.d.ts",
			"import": "./dist/build/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run --root ../.. --project @financica/ubl",
		"test:watch": "vitest --root ../.. --project @financica/ubl",
		"test:coverage": "vitest --root ../.. --project @financica/ubl run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@financica/peppol": ">=0.8.0 <1.0.0",
		"@xmldom/xmldom": "^0.9.11"
	},
	"engines": {
		"node": ">=24"
	}
}
