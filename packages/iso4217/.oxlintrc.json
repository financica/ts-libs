{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"unicorn/no-array-sort": "off"
	},
	"ignorePatterns": ["dist", "src/codes.ts", "src/data.ts", "src/historic-data.ts"]
}
