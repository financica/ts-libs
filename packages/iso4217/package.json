{
	"name": "@financica/iso4217",
	"version": "0.2.0",
	"description": "ISO 4217 currency codes, numeric codes, minor units, and entities — fully typed, zero dependencies, O(1) lookups.",
	"keywords": [
		"currencies",
		"currency",
		"currency-codes",
		"finance",
		"iso-4217",
		"iso4217",
		"money",
		"typescript"
	],
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/iso4217#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/iso4217"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/__tests__/**",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./historic": {
			"types": "./dist/historic.d.ts",
			"import": "./dist/historic.js",
			"require": "./dist/historic.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"generate": "tsx scripts/generate.ts",
		"fetch-data": "tsx scripts/fetch.ts",
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run --root ../.. --project @financica/iso4217",
		"test:watch": "vitest --root ../.. --project @financica/iso4217",
		"test:coverage": "vitest --root ../.. --project @financica/iso4217 run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"devDependencies": {
		"fast-xml-parser": "^5.11.0",
		"tsx": "^4.23.12"
	},
	"engines": {
		"node": ">=24"
	}
}
