{
	"name": "@financica/peppol",
	"version": "0.7.0",
	"description": "Peppol network toolkit for TypeScript: participant discovery via SML/SMP, Peppol Directory lookups, EAS schemes, and document-type classification.",
	"keywords": [
		"e-invoicing",
		"eas",
		"einvoice",
		"en16931",
		"peppol",
		"sml",
		"smp",
		"ubl",
		"vat"
	],
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/peppol#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/peppol"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./schemes": {
			"import": "./dist/schemes.js",
			"types": "./dist/schemes.d.ts"
		},
		"./document-types": {
			"import": "./dist/document-types.js",
			"types": "./dist/document-types.d.ts"
		},
		"./countries": {
			"import": "./dist/countries.js",
			"types": "./dist/countries.d.ts"
		},
		"./identifiers": {
			"import": "./dist/identifiers.js",
			"types": "./dist/identifiers.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"dependencies": {
		"fast-xml-parser": "^5.10.1"
	},
	"engines": {
		"node": ">=24"
	}
}
