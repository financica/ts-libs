{
	"name": "@financica/xbrl",
	"version": "0.1.0",
	"description": "TypeScript parser for XBRL 2.1 instance documents",
	"license": "MIT",
	"files": [
		"dist",
		"docs"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "tsc --noEmit",
		"ci": "bun run typecheck && bun run lint && bun run test && bun run build",
		"prepack": "bun run build"
	},
	"dependencies": {
		"fast-xml-parser": "^5.10.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"tsdown": "^0.22.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
