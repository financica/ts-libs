{
	"name": "@financica/stripe-hosted-invoices",
	"version": "0.1.0",
	"description": "Read a Stripe invoice, credit note or receipt from its public hosted URL — no API key, using the same ephemeral-key protocol the hosted invoice page uses itself.",
	"keywords": [
		"accounting",
		"credit-note",
		"e-invoicing",
		"ephemeral-key",
		"hosted-invoice",
		"invoice",
		"receipt",
		"stripe",
		"typescript"
	],
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/stripe-hosted-invoices#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/stripe-hosted-invoices"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"dependencies": {
		"node-html-parser": "^9.0.1"
	},
	"engines": {
		"node": ">=24"
	}
}
