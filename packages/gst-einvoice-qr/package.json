{
	"name": "@financica/gst-einvoice-qr",
	"version": "0.1.0",
	"description": "Decode, cryptographically verify and reconcile the signed QR code printed on Indian GST e-invoices (IRP / IRN). Zero dependencies.",
	"keywords": [
		"accounting",
		"e-invoicing",
		"gst",
		"gstin",
		"india",
		"invoice",
		"irn",
		"irp",
		"jws",
		"qr-code",
		"typescript"
	],
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/gst-einvoice-qr#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/gst-einvoice-qr"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/__tests__/**",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run --root ../.. --project @financica/gst-einvoice-qr",
		"test:watch": "vitest --root ../.. --project @financica/gst-einvoice-qr",
		"test:coverage": "vitest --root ../.. --project @financica/gst-einvoice-qr run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"engines": {
		"node": ">=24"
	}
}
