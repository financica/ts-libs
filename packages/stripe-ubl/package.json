{
	"name": "@financica/stripe-ubl",
	"version": "1.1.0",
	"description": "Convert Stripe invoices and credit notes into Peppol BIS Billing 3.0 UBL documents.",
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/stripe-ubl#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/stripe-ubl"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@financica/ubl": "^0.14.0"
	},
	"devDependencies": {
		"stripe": "^22.5.0"
	},
	"peerDependencies": {
		"stripe": ">=22.0.0"
	},
	"engines": {
		"node": ">=24"
	}
}
