{
	"name": "@financica/stripe-ubl",
	"version": "3.0.0",
	"description": "Convert Stripe invoices and credit notes into Peppol BIS Billing 3.0 UBL documents.",
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/stripe-ubl#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/stripe-ubl"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/__tests__/**",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run --root ../.. --project @financica/stripe-ubl",
		"test:watch": "vitest --root ../.. --project @financica/stripe-ubl",
		"test:coverage": "vitest --root ../.. --project @financica/stripe-ubl run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@financica/ubl": "^0.17.0"
	},
	"devDependencies": {
		"stripe": "^22.5.0"
	},
	"peerDependencies": {
		"stripe": ">=22.0.0"
	},
	"engines": {
		"node": ">=24"
	}
}
