{
	"name": "@financica/react-ubl-renderer",
	"version": "0.2.0",
	"description": "Render parsed UBL / Peppol BIS Billing 3.0 invoices as a React component or a standalone HTML document.",
	"keywords": [
		"e-invoicing",
		"einvoice",
		"en16931",
		"invoice",
		"peppol",
		"react",
		"ubl"
	],
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/react-ubl-renderer#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/react-ubl-renderer"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./styles.css": "./dist/styles.css"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown && node scripts/emit-css.mjs",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"devDependencies": {
		"@financica/ubl": "workspace:*",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"peerDependencies": {
		"@financica/ubl": ">=0.6.0 <1.0.0",
		"react": ">=18",
		"react-dom": ">=18"
	},
	"engines": {
		"node": ">=24"
	}
}
