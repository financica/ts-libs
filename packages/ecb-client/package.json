{
	"name": "@financica/ecb-client",
	"version": "0.2.1",
	"description": "Zero-dependency client for the European Central Bank's euro foreign-exchange reference rates: single-day historical lookups, date-range series, and fallback to the last business day.",
	"keywords": [
		"accounting",
		"currency",
		"ecb",
		"eur",
		"euro",
		"exchange-rates",
		"forex",
		"fx",
		"reference-rates",
		"typescript"
	],
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/ecb-client#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/ecb-client"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/__tests__/**",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run --root ../.. --project @financica/ecb-client",
		"test:watch": "vitest --root ../.. --project @financica/ecb-client",
		"test:coverage": "vitest --root ../.. --project @financica/ecb-client run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"engines": {
		"node": ">=24"
	}
}
