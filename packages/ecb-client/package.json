{
	"name": "@financica/ecb-client",
	"version": "0.1.0",
	"description": "Tiny, zero-dependency client for the European Central Bank euro foreign-exchange reference rates, with historical single-day lookups and last-business-day fallback.",
	"keywords": [
		"accounting",
		"currency",
		"ecb",
		"eur",
		"euro",
		"exchange-rates",
		"forex",
		"fx",
		"reference-rates",
		"typescript"
	],
	"homepage": "https://github.com/financica/ecb-client#readme",
	"bugs": {
		"url": "https://github.com/financica/ecb-client/issues"
	},
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ecb-client.git"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"clean": "rm -rf dist",
		"lint": "tsc --noEmit",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"ci": "npm run lint && npm run test && npm run build",
		"prepublishOnly": "npm run clean && npm run build && npm test"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsup": "^8.3.0",
		"typescript": "^5.6.0",
		"vitest": "^2.1.0"
	},
	"engines": {
		"node": ">=18"
	}
}
