{
	"name": "@financica/nbb-cbso",
	"version": "0.6.1",
	"description": "Belgian annual-accounts filing for the NBB/BNB Central Balance Sheet Office: build, validate and render NBB-CBSO XBRL instance documents.",
	"keywords": [
		"accounting",
		"annual-accounts",
		"balanscentrale",
		"belgium",
		"cbso",
		"centrale-des-bilans",
		"nbb",
		"typescript",
		"xbrl"
	],
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/nbb-cbso#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/nbb-cbso"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./taxonomies/*": {
			"types": "./dist/taxonomies/*.d.ts",
			"import": "./dist/taxonomies/*.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"generate": "bun run scripts/generate-taxonomy.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@financica/xbrl": "^0.2.0"
	},
	"devDependencies": {
		"fast-xml-parser": "^5.11.0"
	},
	"engines": {
		"node": ">=24"
	}
}
