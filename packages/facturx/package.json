{
	"name": "@financica/facturx",
	"version": "0.1.0",
	"description": "Factur-X / ZUGFeRD (EN 16931 CII) hybrid e-invoice toolkit for TypeScript: parse, generate, and embed structured invoices in PDF/A-3.",
	"keywords": [
		"accounting",
		"cii",
		"e-invoice",
		"e-invoicing",
		"en16931",
		"factur-x",
		"hybrid-invoice",
		"pdf-a3",
		"typescript",
		"xrechnung",
		"zugferd"
	],
	"homepage": "https://github.com/financica/facturx-ts#readme",
	"bugs": {
		"url": "https://github.com/financica/facturx-ts/issues"
	},
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/facturx-ts.git"
	},
	"files": [
		"dist",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./parse": {
			"types": "./dist/parse/index.d.ts",
			"import": "./dist/parse/index.js"
		},
		"./generate": {
			"types": "./dist/generate/index.d.ts",
			"import": "./dist/generate/index.js"
		},
		"./pdf": {
			"types": "./dist/pdf/index.d.ts",
			"import": "./dist/pdf/index.js"
		},
		"./render": {
			"types": "./dist/render/index.d.ts",
			"import": "./dist/render/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"clean": "rm -rf dist",
		"lint": "eslint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"type-check": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest --run",
		"test:coverage": "vitest --coverage",
		"ci": "npm run type-check && npm run lint && npm run test:run && npm run build",
		"prepack": "npm run build",
		"prepublishOnly": "npm run ci"
	},
	"dependencies": {
		"@cantoo/pdf-lib": "^2.7.1",
		"@pdf-lib/fontkit": "^1.1.1",
		"fast-xml-parser": "^5.9.3"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"eslint": "^10.6.0",
		"prettier": "^3.9.4",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.63.0",
		"vitest": "^4.1.10"
	},
	"prettier": {
		"overrides": [
			{
				"files": "*.{yml,yaml}",
				"options": {
					"tabWidth": 2,
					"useTabs": false
				}
			}
		],
		"printWidth": 88,
		"tabWidth": 4,
		"useTabs": true
	},
	"engines": {
		"node": ">=18"
	}
}
