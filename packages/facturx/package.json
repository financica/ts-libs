{
	"name": "@financica/facturx",
	"version": "0.1.1",
	"description": "Factur-X / ZUGFeRD (EN 16931 CII) hybrid e-invoice toolkit for TypeScript: parse, generate, and embed structured invoices in PDF/A-3.",
	"keywords": [
		"accounting",
		"cii",
		"e-invoice",
		"e-invoicing",
		"en16931",
		"factur-x",
		"hybrid-invoice",
		"pdf-a3",
		"typescript",
		"xrechnung",
		"zugferd"
	],
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/facturx#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/facturx"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/__tests__/**",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./parse": {
			"types": "./dist/parse/index.d.ts",
			"import": "./dist/parse/index.js"
		},
		"./generate": {
			"types": "./dist/generate/index.d.ts",
			"import": "./dist/generate/index.js"
		},
		"./pdf": {
			"types": "./dist/pdf/index.d.ts",
			"import": "./dist/pdf/index.js"
		},
		"./render": {
			"types": "./dist/render/index.d.ts",
			"import": "./dist/render/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run --root ../.. --project @financica/facturx",
		"test:watch": "vitest --root ../.. --project @financica/facturx",
		"test:coverage": "vitest --root ../.. --project @financica/facturx run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"dependencies": {
		"@cantoo/pdf-lib": "^2.8.4",
		"fast-xml-parser": "^5.11.0",
		"fontkit": "^2.0.4"
	},
	"devDependencies": {
		"@types/fontkit": "^2.0.9"
	},
	"engines": {
		"node": ">=24"
	}
}
