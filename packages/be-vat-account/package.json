{
	"name": "@financica/be-vat-account",
	"version": "0.3.0",
	"description": "Parser for the Belgian VAT current-account statement (Extrait de compte TVA / Uittreksel btw-rekening) issued by the FPS Finance — PFORM671 and legacy layouts, French and Dutch.",
	"keywords": [
		"accounting",
		"belgium",
		"btw",
		"finances",
		"fps-finance",
		"pdf",
		"pform671",
		"spf-finances",
		"statement",
		"tva",
		"typescript",
		"vat"
	],
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/be-vat-account#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/be-vat-account"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/**/__tests__/**",
		"CHANGELOG.md",
		"LICENSE",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./amount": {
			"types": "./dist/amount.d.ts",
			"import": "./dist/amount.js",
			"require": "./dist/amount.cjs"
		},
		"./operations": {
			"types": "./dist/operations.d.ts",
			"import": "./dist/operations.js",
			"require": "./dist/operations.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run --root ../.. --project @financica/be-vat-account",
		"test:watch": "vitest --root ../.. --project @financica/be-vat-account",
		"test:coverage": "vitest --root ../.. --project @financica/be-vat-account run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"dependencies": {
		"unpdf": "^1.8.1"
	},
	"engines": {
		"node": ">=24"
	}
}
