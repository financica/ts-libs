{
	"name": "@financica/edavki",
	"version": "0.1.0",
	"description": "TypeScript toolkit for Slovenian eDavki (FURS) tax documents: build and serialize the DDV-O VAT return as schema-faithful EDP XML.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/edavki-ts.git"
	},
	"files": [
		"dist",
		"schemas"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./ddv-o": {
			"import": "./dist/ddv-o/index.js",
			"types": "./dist/ddv-o/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsup",
		"prepack": "npm run build",
		"lint": "eslint",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"type-check": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest --run",
		"test:coverage": "vitest --coverage",
		"ci": "npm run type-check && npm run lint && npm run test:run && npm run build"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"eslint": "^10.6.0",
		"fast-xml-parser": "^5.9.3",
		"prettier": "^3.9.4",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.63.0",
		"vitest": "^4.1.10"
	}
}
