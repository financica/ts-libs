{
	"name": "@ingram-tech/myminfin",
	"version": "0.6.0",
	"description": "TypeScript client and document generators for the Belgian SPF Finances MyMinFin and Intervat APIs",
	"license": "MIT",
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsdown",
		"prepack": "bun run build",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"type-check": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest --run",
		"test:coverage": "vitest --coverage",
		"ci": "bun run type-check && bun run lint && bun run test:run && bun run build"
	},
	"dependencies": {
		"jose": "^6.2.3"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"fast-xml-parser": "^5.10.0",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"tsdown": "^0.22.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
