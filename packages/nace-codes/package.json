{
	"name": "@financica/nace-codes",
	"version": "2.0.0",
	"description": "TypeScript library for NACE and NACEBEL economic activity classification codes",
	"keywords": [
		"belgium",
		"classification",
		"economic-activity",
		"europe",
		"nace",
		"nacebel"
	],
	"homepage": "https://github.com/financica/ts-libs/tree/main/packages/nace-codes#readme",
	"bugs": "https://github.com/financica/ts-libs/issues",
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/financica/ts-libs.git",
		"directory": "packages/nace-codes"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./nacebel": {
			"types": "./dist/nacebel.d.ts",
			"import": "./dist/nacebel.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"generate:data": "bun scripts/generateDataModules.ts",
		"build": "bun run generate:data && tsdown",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"ci": "bun run lint && bun run format:check && bun run build && bun run typecheck && bun run test",
		"prepack": "bun run build"
	},
	"engines": {
		"node": ">=24"
	}
}
