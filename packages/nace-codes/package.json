{
	"name": "nace-codes",
	"version": "2.0.0",
	"description": "TypeScript library for NACE and NACEBEL economic activity classification codes",
	"keywords": [
		"belgium",
		"classification",
		"economic-activity",
		"europe",
		"nace",
		"nacebel"
	],
	"homepage": "https://github.com/ingram-technologies/nace-codes#readme",
	"bugs": {
		"url": "https://github.com/ingram-technologies/nace-codes/issues"
	},
	"license": "MIT",
	"author": "Financica",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ingram-technologies/nace-codes.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./nacebel": {
			"types": "./dist/nacebel.d.ts",
			"import": "./dist/nacebel.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"generate:data": "bun scripts/generateDataModules.ts",
		"build": "bun run generate:data && tsdown",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"typecheck": "tsc --noEmit",
		"ci": "bun run typecheck && bun run lint && bun run test && bun run build",
		"prepack": "bun run build"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@vitest/coverage-v8": "^4.1.10",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"tsdown": "^0.22.5",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=18"
	}
}
